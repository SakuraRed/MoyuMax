{
  "formatVersion": 2,
  "id": "my-theme",
  "name": "我的主题",
  "author": "你的名字",
  "description": "基于主题包标准 v2 的起步模板:先改 base.tokens,再按需加 overrides",
  "appVersion": { "min": "0.1.0" },
  "base": {
    "tokens": {
      "--bg-0": "#14171c",
      "--bg-1": "#1b1f26",
      "--bg-2": "#232833",
      "--glass": "rgba(27, 31, 38, 0.72)",
      "--glass-strong": "rgba(27, 31, 38, 0.92)",
      "--glass-border": "rgba(255, 255, 255, 0.10)",
      "--glass-highlight": "rgba(255, 255, 255, 0.08)",
      "--text-1": "#e8ecf1",
      "--text-2": "#a8b2c0",
      "--text-3": "#6d7889",
      "--accent": "#5b9cf5",
      "--accent-ink": "#0c1420",
      "--accent-soft": "rgba(91, 156, 245, 0.18)",
      "--r": "12px"
    },
    "rules": [
      {
        "selector": ".panel",
        "declarations": {
          "border-radius": "14px",
          "box-shadow": "inset 0 1px 0 var(--glass-highlight)"
        }
      },
      {
        "selector": ".btn.primary",
        "declarations": {
          "background": "var(--accent)",
          "color": "var(--accent-ink)"
        }
      }
    ]
  },
  "overrides": [
    {
      "name": "首页 hero 强调",
      "pages": ["home"],
      "appVersion": { "min": "0.1.0", "max": "0.2.x" },
      "rules": [
        {
          "selector": ".hero-card",
          "declarations": {
            "border-radius": "18px",
            "box-shadow": "inset 0 3px 0 var(--accent-soft), var(--shadow-1)"
          }
        }
      ]
    }
  ]
}
